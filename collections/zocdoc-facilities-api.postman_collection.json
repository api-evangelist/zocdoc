      "description": {
        "content": "Endpoints to retrieve facilities within the developer's directory.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "74b680aa-4937-4880-bf7f-3d3e52b3eb2f",
          "name": "Get facilities",
          "request": {
            "name": "Get facilities",
            "description": {
              "content": "Get a set of facilities within the developer's network.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1-beta",
                "facilities"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "npis",
                  "value": "<string>",
                  "description": "A comma-delimited list of Provider NPI numbers. A maximum of 50 items will be accepted at a time. One of `zip_code` or `npis` is required."
                },
                {
                  "disabled": false,
                  "key": "zip_code",
                  "value": "<string>",
                  "description": "A 5 digit zip code that will be used as the location to find facilities near by. One of `zip_code` or `npis` is required."
                },
                {
                  "disabled": false,
                  "key": "building_type",
                  "value": "<string>",
                  "description": "The type of facility building, which can be Clinic or Hospital."
                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "The zero indexed page of results."
                },
                {
                  "disabled": false,
                  "key": "page_size",
                  "value": "<integer>",
                  "description": "The number of results to return per page."
                },
                {
                  "disabled": false,
                  "key": "visit_reason_id",
                  "value": "<string>",
                  "description": "The Zocdoc ID of the visit reason to search by `zip_code` for. See [Reference Data](/guides/reference-data) for options."
                },
                {
                  "disabled": false,
                  "key": "insurance_plan_id",
                  "value": "<string>",
                  "description": "The Zocdoc ID of the patient's insurance plan to search by `zip_code` for. Use the [Get Insurance Plans](#operation/getInsurancePlans) endpoint to retrieve available plans."
                },
                {
                  "disabled": false,
                  "key": "max_distance_to_patient_mi",
                  "value": "<integer>",
                  "description": "The maximum distance in miles from the facility to the search location (the center point of the given `zip_code`). Default is 50 miles."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "scope",
                  "value": "external.credential.rotate external.appointment.write external.appointment.read external.anonymous_token.write external.provider_insurance.write external.schedulable_entity.read"
